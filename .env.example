APP_NAME=Atlas
APP_ENVIRONMENT=development

OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=60

MODEL_MAX_ATTEMPTS=2
MODEL_RETRY_BASE_DELAY_SECONDS=0.5
MODEL_RETRY_MAX_DELAY_SECONDS=4.0
MODEL_RETRY_JITTER_RATIO=0.2

QDRANT_URL=
QDRANT_COLLECTION=atlas_documents

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

RETRIEVAL_TOP_K=5

SPARSE_EMBEDDING_MODEL=Qdrant/bm25

RETRIEVAL_CANDIDATE_K=20
RERANK_TOP_K=8
CONTEXT_TOP_K=5

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

MAX_CONTEXT_CHARS=7000

TELEMETRY_ENABLED=true
TELEMETRY_CONSOLE_EXPORT=false

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

TELEMETRY_CAPTURE_CONTENT=false

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas

RESEARCH_DEADLINE_SECONDS=90

MODEL_CONCURRENCY_LIMIT=2
RERANKER_CONCURRENCY_LIMIT=2
TOOL_CONCURRENCY_LIMIT=10

CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30