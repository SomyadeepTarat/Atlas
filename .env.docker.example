APP_NAME=Atlas
APP_ENVIRONMENT=production

DATABASE_URL=postgresql+asyncpg://atlas:atlas@postgres:5432/atlas
LANGGRAPH_DATABASE_URL=postgresql://atlas:atlas@postgres:5432/atlas

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=atlas_documents

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=60

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

MODEL_MAX_ATTEMPTS=2

RESEARCH_MAX_ITERATIONS=3
RESEARCH_DEADLINE_SECONDS=90

FRONTEND_ORIGIN=http://localhost:3000

TELEMETRY_ENABLED=true
TELEMETRY_CONSOLE_EXPORT=false
TELEMETRY_CAPTURE_CONTENT=false

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

ENABLE_DEBUG_TOOL_API=false